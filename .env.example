# All settings are optional. The app works with no keys using Shazam.

# AudD (https://audd.io). If set, AudD is used as a second recognizer.
AUDD_API_TOKEN=

# Path to a Netscape cookies.txt exported from a logged-in Instagram session.
# Helps with private reels, rate limits and Instagram's own song info.
INSTAGRAM_COOKIES_FILE=

# Max upload size in MB (default 100) and max audio length scanned in seconds (default 180).
MAX_UPLOAD_MB=100
MAX_SCAN_SECONDS=180
